{
  "name": "alipadron-dev",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/build-site-files.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "documents": "tsx scripts/build-documents.ts --publish",
    "pdf": "tsx scripts/build-documents.ts --pdf-only",
    "og-image": "tsx scripts/build-og-image.ts"
  },
  "dependencies": {
    "@analogjs/router": "^2.9.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "docx": "^9.15.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.9.6",
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/node": "^26.6.6",
    "fflate": "^0.8.3",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "unpdf": "^2.1.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  }
}
